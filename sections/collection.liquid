<div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="margin-bottom: 3rem; display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1rem;">
    <div>
      <span style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.1em; color: var(--color-accent, #2563eb);">Collection Catalog</span>
      <h1 style="font-size: clamp(2rem, 4vw, 3rem); font-weight: 800; margin-top: 0.2rem; color: #0f172a;">
        {{ collection.title | default: "All Products" }}
      </h1>
      {% if collection.description != blank %}
        <div style="margin-top: 0.5rem; opacity: 0.8; max-width: 700px;">
          {{ collection.description }}
        </div>
      {% endif %}
    </div>

    <div style="display: flex; align-items: center; gap: 1rem;">
      <button type="button" class="btn btn-outline" data-open-filter-drawer style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.25rem; font-size: 0.9rem; font-weight: 600;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="4" y1="21" x2="4" y2="14"></line>
          <line x1="4" y1="10" x2="4" y2="3"></line>
          <line x1="12" y1="21" x2="12" y2="12"></line>
          <line x1="12" y1="8" x2="12" y2="3"></line>
          <line x1="20" y1="21" x2="20" y2="16"></line>
          <line x1="20" y1="12" x2="20" y2="3"></line>
          <line x1="1" y1="14" x2="7" y2="14"></line>
          <line x1="9" y1="8" x2="15" y2="8"></line>
          <line x1="17" y1="16" x2="23" y2="16"></line>
        </svg>
        Filter Products
      </button>
    </div>
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    {% if collection.products.size > 0 %}
      <div class="shop-editorial-container">
        <!-- ROW 1: Standard 4-Column Row (Products 1-4) -->
        <div class="grid grid-4" style="margin-bottom: 2rem;">
          {% for product in collection.products limit: 4 %}
            {% render 'product-card', card_product: product %}
          {% endfor %}
        </div>

        <!-- ROW 2: Editorial Split Layout (Only shown when at least 7 products exist to fill 2x2 grid beside banner) -->
        {% assign render_row2_banner = false %}
        {% if collection.products.size >= 7 %}
          {% assign render_row2_banner = true %}
        {% endif %}

        {% if render_row2_banner %}
          <div class="editorial-shop-row banner-right" style="margin-top: 2rem;">
            <!-- 2x2 Grid of Products on Left -->
            <div class="editorial-products-grid">
              {% for product in collection.products offset: 4 limit: 4 %}
                {% render 'product-card', card_product: product %}
              {% endfor %}
            </div>

            <!-- Full-Height Editorial Display Banner on Right -->
            <div class="editorial-banner-card">
              {% if section.settings.banner_image_1 != blank %}
                <img
                  src="{{ section.settings.banner_image_1 | image_url: width: 1000 }}"
                  alt="{{ section.settings.banner_tag_1 | default: 'New In' | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1515886657613-9f3515b0c78f?auto=format&fit=crop&w=1000&q=80"
                  alt="Editorial Lookbook"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {% endif %}
              <div class="editorial-banner-overlay">
                <div class="editorial-banner-tag">
                  {{ section.settings.banner_tag_1 | default: 'New In' }}
                </div>
              </div>
            </div>
          </div>
        {% endif %}

        <!-- ROW 3: Editorial Split Layout (Only shown when at least 11 products exist to fill 2x2 grid beside banner) -->
        {% assign render_row3_banner = false %}
        {% if collection.products.size >= 11 %}
          {% assign render_row3_banner = true %}
        {% endif %}

        {% if render_row3_banner %}
          <div class="editorial-shop-row banner-left" style="margin-top: 2rem;">
            <!-- Full-Height Editorial Display Banner on Left -->
            <div class="editorial-banner-card">
              {% if section.settings.banner_image_2 != blank %}
                <img
                  src="{{ section.settings.banner_image_2 | image_url: width: 1000 }}"
                  alt="{{ section.settings.banner_tag_2 | default: 'Featured Edit' | escape }}"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {% else %}
                <img
                  src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1000&q=80"
                  alt="Editorial Lookbook"
                  loading="lazy"
                  width="600"
                  height="800"
                >
              {% endif %}
              <div class="editorial-banner-overlay">
                <div class="editorial-banner-tag">
                  {{ section.settings.banner_tag_2 | default: 'Featured Edit' }}
                </div>
              </div>
            </div>

            <!-- 2x2 Grid of Products on Right -->
            <div class="editorial-products-grid">
              {% for product in collection.products offset: 8 limit: 4 %}
                {% render 'product-card', card_product: product %}
              {% endfor %}
            </div>
          </div>
        {% endif %}

        <!-- ROW 4: Remaining Products Grid -->
        {% assign offset_count = 4 %}
        {% if render_row2_banner %}
          {% assign offset_count = 8 %}
        {% endif %}
        {% if render_row3_banner %}
          {% assign offset_count = 12 %}
        {% endif %}

        {% if collection.products.size > offset_count %}
          <div class="grid grid-4" style="margin-top: 2rem;">
            {% for product in collection.products offset: offset_count %}
              {% render 'product-card', card_product: product %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% else %}
      <div style="text-align: center; padding: 5rem 0;">
        <p style="font-size: 1.25rem; opacity: 0.7;">No products found in this collection.</p>
      </div>
    {% endif %}

    {% if paginate.pages > 1 %}
      <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 4rem;">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="btn btn-outline">&larr; Previous</a>
        {% endif %}

        <span style="display: flex; align-items: center; padding: 0 1rem; font-weight: 600;">
          Page {{ paginate.current_page }} of {{ paginate.pages }}
        </span>

        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="btn btn-outline">Next &rarr;</a>
        {% endif %}
      </div>
    {% endif %}
  {% endpaginate %}
</div>

<style>
.shop-editorial-container {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.editorial-shop-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 2rem;
  align-items: stretch;
}

.editorial-products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

.editorial-banner-card {
  position: relative;
  border-radius: var(--border-radius, 12px);
  overflow: hidden;
  height: 100%;
  min-height: 520px;
  background: var(--color-card-bg, #f8fafc);
  display: block;
  cursor: default;
}

.editorial-banner-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.editorial-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(0, 0, 0, 0.65) 100%);
  display: flex;
  align-items: flex-end;
  padding: 2rem;
  color: #ffffff;
}

.editorial-banner-tag {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  color: #ffffff;
}

.editorial-banner-tag::before {
  content: '';
  display: inline-block;
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #ffffff;
}

@media (max-width: 900px) {
  .editorial-shop-row {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  .editorial-banner-card {
    min-height: 380px;
    order: -1;
  }
}
</style>

{% schema %}
{
  "name": "Shop Editorial Grid",
  "tag": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 16
    },
    {
      "type": "header",
      "content": "First Editorial Side Banner (Right)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_1",
      "label": "Right Banner Image"
    },
    {
      "type": "text",
      "id": "banner_tag_1",
      "label": "Banner Tag / Label",
      "default": "New In"
    },
    {
      "type": "header",
      "content": "Second Editorial Side Banner (Left)"
    },
    {
      "type": "image_picker",
      "id": "banner_image_2",
      "label": "Left Banner Image"
    },
    {
      "type": "text",
      "id": "banner_tag_2",
      "label": "Banner Tag / Label",
      "default": "Featured Edit"
    }
  ]
}
{% endschema %}
