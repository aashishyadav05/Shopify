<div class="container">
  <div class="hero-section" style="text-align: {{ section.settings.text_alignment }};">
    {% if section.settings.image != blank %}
      <img
        src="{{ section.settings.image | image_url: width: 1600 }}"
        alt="{{ section.settings.heading | escape }}"
        class="hero-bg-image"
        loading="eager"
        width="1600"
        height="800"
      >
      <div
        class="hero-overlay"
        style="background: rgba(0, 0, 0, {{ section.settings.image_overlay_opacity | divided_by: 100.0 }});"
      ></div>
    {% endif %}

    <div class="hero-content" style="{% if section.settings.image != blank %}color: #ffffff;{% endif %} margin: {% if section.settings.text_alignment == 'center' %}0 auto{% elsif section.settings.text_alignment == 'right' %}0 0 0 auto{% else %}0{% endif %};">
      {% if section.settings.heading != blank %}
        <h1 class="hero-title">{{ section.settings.heading }}</h1>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <div class="hero-subtext">{{ section.settings.subtext }}</div>
      {% endif %}

      {% if section.settings.button_label != blank and section.settings.button_link != blank %}
        <a href="{{ section.settings.button_link }}" class="btn btn-accent">
          {{ section.settings.button_label }}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Hero Banner",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner Image"
    },
    {
      "type": "range",
      "id": "image_overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 10,
      "unit": "%",
      "label": "Image overlay opacity",
      "default": 30
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Elevate Your Style"
    },
    {
      "type": "richtext",
      "id": "subtext",
      "label": "Subheading",
      "default": "<p>Discover our latest dynamic collection crafted for modern living.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "Hero Banner"
    }
  ]
}
{% endschema %}
