<div class="contact-section-wrapper" style="padding: 4rem 0 6rem; background: var(--color-bg, #ffffff); color: var(--color-text, #0f172a);">
  <div class="container">
    <div class="contact-grid">
      <!-- Left Column: Image (Managed strictly via Shopify Theme Editor) -->
      <div class="contact-image-col">
        {% if section.settings.image != blank %}
          <img
            src="{{ section.settings.image | image_url: width: 1400 }}"
            alt="{{ section.settings.heading | escape }}"
            loading="lazy"
            width="800"
            height="1000"
            class="contact-featured-img"
          >
        {% else %}
          <div class="contact-img-placeholder" style="width: 100%; height: 100%; min-height: calc(100vh - 180px); background: #f1f5f9; display: flex; align-items: center; justify-content: center; color: #94a3b8;">
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <!-- Right Column: Read-Only Contact Details -->
      <div class="contact-info-col">
        <span class="contact-badge">
          {{ section.settings.subheading | default: 'Get In Touch' }}
        </span>

        <h1 class="contact-title">
          {{ section.settings.heading | default: 'Contact Us & Store Location' }}
        </h1>

        <p class="contact-about">
          {{ section.settings.about_text | default: "We are committed to delivering exceptional quality, timeless design, and unmatched customer service. Reach out to us for store inquiries, customer support, or partnership opportunities." }}
        </p>

        <div class="contact-details-list">
          <!-- Address Card -->
          <div class="contact-detail-card">
            <div class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </div>
            <div>
              <div class="contact-label">{{ section.settings.store_name | default: 'Egoiste Flagship Store' }}</div>
              <div class="contact-value">{{ section.settings.address | default: '100 Alpine Forest Way, Suite 400, CA 94041' }}</div>
            </div>
          </div>

          <!-- Phone Card -->
          <div class="contact-detail-card">
            <div class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
            </div>
            <div>
              <div class="contact-label">Call Us</div>
              <a href="tel:{{ section.settings.phone | default: '+18005550199' }}" class="contact-link">
                {{ section.settings.phone | default: '+1 (800) 555-0199' }}
              </a>
            </div>
          </div>

          <!-- Email Card -->
          <div class="contact-detail-card">
            <div class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
            </div>
            <div>
              <div class="contact-label">Email Us</div>
              <a href="mailto:{{ section.settings.email | default: 'contact@egoiste.com' }}" class="contact-link">
                {{ section.settings.email | default: 'contact@egoiste.com' }}
              </a>
            </div>
          </div>

          <!-- Opening Hours Card -->
          <div class="contact-detail-card">
            <div class="contact-icon">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div>
              <div class="contact-label">Opening Hours</div>
              <div class="contact-value">{{ section.settings.hours | default: 'Mon - Sat: 10:00 AM - 8:00 PM | Sun: 11:00 AM - 6:00 PM' }}</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
.contact-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 4rem;
  align-items: center;
}

.contact-image-col {
  border-radius: var(--border-radius, 16px);
  overflow: hidden;
  box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
  height: 100%;
  min-height: calc(100vh - 220px);
  display: flex;
  align-items: stretch;
}

.contact-featured-img {
  width: 100%;
  height: 100%;
  min-height: calc(100vh - 220px);
  object-fit: cover;
  display: block;
}

.contact-badge {
  display: inline-block;
  font-size: 0.8rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-accent, #2563eb);
  margin-bottom: 0.75rem;
}

.contact-title {
  font-family: 'Playfair Display', Georgia, serif;
  font-size: clamp(2rem, 4vw, 3rem);
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 1.25rem;
  color: #0f172a;
}

.contact-about {
  font-size: 1.05rem;
  line-height: 1.7;
  color: #475569;
  margin-bottom: 2.5rem;
}

.contact-details-list {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.contact-detail-card {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  padding: 1.25rem 1.5rem;
  background: var(--color-card-bg, #f8fafc);
  border: 1px solid var(--color-border, #e2e8f0);
  border-radius: var(--border-radius, 12px);
  transition: transform 0.2s, box-shadow 0.2s;
}

.contact-detail-card:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.04);
}

.contact-icon {
  background: #ffffff;
  color: var(--color-accent, #2563eb);
  padding: 0.75rem;
  border-radius: 10px;
  box-shadow: 0 4px 10px rgba(0,0,0,0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.contact-label {
  font-size: 0.85rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: #64748b;
  margin-bottom: 0.25rem;
}

.contact-value {
  font-size: 1rem;
  font-weight: 600;
  color: #0f172a;
  line-height: 1.4;
}

.contact-link {
  font-size: 1.05rem;
  font-weight: 700;
  color: var(--color-accent, #2563eb);
  text-decoration: none;
}

.contact-link:hover {
  text-decoration: underline;
}

@media (max-width: 900px) {
  .contact-grid {
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
}
</style>

{% schema %}
{
  "name": "Contact Page Info",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Featured Image"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Get In Touch"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Contact Us & Store Location"
    },
    {
      "type": "textarea",
      "id": "about_text",
      "label": "About Us Summary",
      "default": "We are committed to delivering exceptional quality, timeless design, and unmatched customer service. Reach out to us for store inquiries, customer support, or partnership opportunities."
    },
    {
      "type": "text",
      "id": "store_name",
      "label": "Store Name",
      "default": "Egoiste Flagship Store"
    },
    {
      "type": "text",
      "id": "address",
      "label": "Address",
      "default": "100 Alpine Forest Way, Suite 400, CA 94041"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "+1 (800) 555-0199"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "contact@egoiste.com"
    },
    {
      "type": "text",
      "id": "hours",
      "label": "Opening Hours",
      "default": "Mon - Sat: 10:00 AM - 8:00 PM | Sun: 11:00 AM - 6:00 PM"
    }
  ],
  "presets": [
    {
      "name": "Contact Page Info"
    }
  ]
}
{% endschema %}
