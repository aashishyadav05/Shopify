<div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 2rem;">Shopping Cart</h1>

  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post" id="cart-form">
      <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 3rem;">
        <div>
          {% for item in cart.items %}
            <div class="cart-item" style="padding: 1.5rem 0;">
              <img
              src="{{ item.image | image_url: width: 240 }}"
              alt="{{ item.title | escape }}"
              class="cart-item-img"
              width="100"
              height="100"
              style="width: 100px; height: 100px;"
            >
              <div class="cart-item-details">
                <a href="{{ item.url }}" class="cart-item-title" style="font-size: 1.1rem;">{{ item.product.title }}</a>
                {% unless item.product.has_only_default_variant %}
                  <div class="cart-item-variant">{{ item.variant.title }}</div>
                {% endunless %}
                <div style="font-weight: 700; margin-top: 0.5rem; font-size: 1.1rem;">{{ item.final_line_price | money }}</div>

                <div style="display: flex; align-items: center; gap: 1.5rem; margin-top: 1rem;">
                  <div class="cart-item-qty">
                    <input
                      type="number"
                      name="updates[]"
                      id="updates_{{ item.key }}"
                      value="{{ item.quantity }}"
                      min="0"
                      style="width: 60px; text-align: center; border: none; padding: 0.4rem 0;"
                    >
                  </div>
                  <a href="{{ item.url_to_remove }}" style="color: var(--color-sale, #dc2626); font-size: 0.875rem; font-weight: 600;">Remove</a>
                </div>
              </div>
            </div>
          {% endfor %}
        </div>

        <div style="background: var(--color-card-bg, #f8fafc); border: 1px solid var(--color-border, #e2e8f0); border-radius: var(--border-radius, 12px); padding: 2rem; height: fit-content;">
          <h2 style="font-size: 1.25rem; font-weight: 700; margin-bottom: 1.5rem;">Order Summary</h2>

          <div class="cart-summary-row">
            <span>Subtotal</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <p style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 1.5rem;">
            Taxes and shipping calculated at checkout
          </p>

          <button type="submit" name="update" class="btn btn-outline" style="width: 100%; margin-bottom: 0.75rem;">
            Update Cart
          </button>

          <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%;">
            Proceed to Checkout
          </button>
        </div>
      </div>
    </form>
  {% else %}
    <div style="text-align: center; padding: 5rem 0;">
      <h2 style="font-size: 1.5rem; opacity: 0.7; margin-bottom: 1.5rem;">Your cart is currently empty.</h2>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary">Continue Shopping</a>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Main Cart",
  "tag": "section"
}
{% endschema %}
