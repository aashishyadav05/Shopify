<div class="container" style="padding-top: 8rem; padding-bottom: 8rem; text-align: center; max-width: 640px;">
  <div style="font-family: 'Playfair Display', Georgia, serif; font-size: clamp(5rem, 12vw, 9rem); font-weight: 400; line-height: 1; opacity: 0.15; letter-spacing: -0.05em; margin-bottom: 1rem;">
    404
  </div>

  <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 1rem;">
    {{ '404.not_found' | t | default: "Page Not Found" }}
  </h1>

  <p style="font-size: 1.1rem; opacity: 0.75; line-height: 1.6; margin-bottom: 2.5rem;">
    The page you are looking for might have been removed, had its name changed, or is temporarily unavailable.
  </p>

  <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
    <a href="{{ routes.root_url }}" class="btn btn-primary" style="padding: 0.85rem 2rem;">
      Return to Homepage
    </a>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-outline" style="padding: 0.85rem 2rem;">
      Browse Products
    </a>
  </div>
</div>

{% schema %}
{
  "name": "404 Page",
  "tag": "section"
}
{% endschema %}
