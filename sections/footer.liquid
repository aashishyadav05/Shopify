<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'link_list' %}
            <div class="footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.title != blank %}
                <h3>{{ block.settings.title }}</h3>
              {% endif %}
              {% assign footer_menu = linklists[block.settings.menu] %}
              {% if footer_menu.links.size > 0 %}
                <ul class="footer-links">
                  {% for link in footer_menu.links %}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {% endfor %}
                </ul>
              {% endif %}
            </div>

          {% when 'text' %}
            <div class="footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading }}</h3>
              {% endif %}
              {% if block.settings.subtext != blank %}
                <div style="opacity:0.8; font-size:0.95rem;">{{ block.settings.subtext }}</div>
              {% endif %}
            </div>

          {% when 'newsletter' %}
            <div class="footer-col" {{ block.shopify_attributes }}>
              {% if block.settings.heading != blank %}
                <h3>{{ block.settings.heading }}</h3>
              {% endif %}
              {% form 'customer', class: 'footer-newsletter-form' %}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div style="display:flex; gap:0.5rem; margin-top:0.75rem;">
                  <input
                    type="email"
                    name="contact[email]"
                    placeholder="Enter your email"
                    required
                    style="padding:0.6rem 1rem; border:1px solid var(--color-border,#e2e8f0); border-radius:8px; width:100%; min-width:0;"
                  >
                  <button type="submit" class="btn btn-primary" style="padding:0.6rem 1.25rem;">Subscribe</button>
                </div>
              {% endform %}
            </div>
        {% endcase %}
      {% endfor %}
    </div>

    <div class="footer-bottom">
      <div>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Powered by Shopify.</div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "link_list",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "About our store"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "label": "Subtext",
          "default": "<p>Share store details, promotions, or brand message with your customers.</p>"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Subscribe to our newsletter"
        }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "link_list" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  }
}
{% endschema %}
