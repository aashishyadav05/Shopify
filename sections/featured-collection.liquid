{% assign selected_collections = section.settings.collections %}
{% if selected_collections == blank %}
  {% assign selected_collections = collections %}
{% endif %}

{% assign valid_collections_count = 0 %}
{% for collection in selected_collections %}
  {% unless collection.handle == 'frontpage' %}
    {% assign valid_collections_count = valid_collections_count | plus: 1 %}
  {% endunless %}
{% endfor %}

{% if valid_collections_count > 0 %}
  <div class="container" style="padding-top: 3rem; padding-bottom: 3rem;">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom: 2rem;">
      <div>
        {% if section.settings.title != blank %}
          <h2 style="font-size: 2rem; font-weight: 800;">
            {{ section.settings.title }}
          </h2>
        {% endif %}
      </div>
    </div>

    <div class="grid grid-{{ section.settings.columns_desktop }}">
      {% for collection in selected_collections %}
        {% unless collection.handle == 'frontpage' %}
          <a href="{{ collection.url }}" class="product-card" style="text-decoration: none;">
            <div class="product-card-media">
              {% if collection.featured_image != blank %}
                <img
                  src="{{ collection.featured_image | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  class="product-card-image"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% elsif collection.products.first.featured_media != blank %}
                <img
                  src="{{ collection.products.first.featured_media | image_url: width: 600 }}"
                  alt="{{ collection.title | escape }}"
                  class="product-card-image"
                  loading="lazy"
                  width="600"
                  height="600"
                >
              {% else %}
                {{ 'collection-1' | placeholder_svg_tag: 'product-card-image' }}
              {% endif %}
            </div>
            <div class="product-card-info" style="text-align: center;">
              <h3 style="font-size: 1.1rem; font-weight: 700; color: var(--color-text, #0f172a);">{{ collection.title }}</h3>
              <span style="font-size: 0.85rem; opacity: 0.7;">{{ collection.all_products_count }} products</span>
            </div>
          </a>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section-featured-collections",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Featured Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections (Leave empty for auto-all)"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "options": [
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    }
  ],
  "presets": [
    {
      "name": "Featured Collections"
    }
  ]
}
{% endschema %}