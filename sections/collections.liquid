<div class="container" style="padding-top: 4rem; padding-bottom: 5rem;">
  <div style="margin-bottom: 3rem;">
    <h1 style="font-size: 2.5rem; font-weight: 800; margin-bottom: 0.5rem;">
      {{ section.settings.title | default: "All Collections" }}
    </h1>
    <p style="opacity: 0.75; font-size: 1.1rem; max-width: 600px;">
      Explore our curated range of collections crafted for everyday luxury.
    </p>
  </div>

  <div class="grid grid-{{ section.settings.columns_desktop }}">
    {% assign valid_count = 0 %}
    {% for collection in collections %}
      {% unless collection.handle == 'frontpage' %}
        {% assign valid_count = valid_count | plus: 1 %}
        <a href="{{ collection.url }}" class="product-card" style="text-decoration: none;">
          <div class="product-card-media">
            {% if collection.featured_image != blank %}
              <img
                src="{{ collection.featured_image | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                class="product-card-image"
                loading="lazy"
                width="800"
                height="800"
              >
            {% elsif collection.products.first.featured_media != blank %}
              <img
                src="{{ collection.products.first.featured_media | image_url: width: 800 }}"
                alt="{{ collection.title | escape }}"
                class="product-card-image"
                loading="lazy"
                width="800"
                height="800"
              >
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag: 'product-card-image' }}
            {% endif %}
          </div>
          <div class="product-card-info" style="text-align: center;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-text, #0f172a); margin-bottom: 0.25rem;">
              {{ collection.title }}
            </h3>
            <span style="font-size: 0.85rem; opacity: 0.7;">
              {{ collection.all_products_count }} products
            </span>
          </div>
        </a>
      {% endunless %}
    {% endfor %}

    {% if valid_count == 0 %}
      {% for i in (1..4) %}
        <div class="product-card">
          <div class="product-card-media">
            {{ 'collection-1' | placeholder_svg_tag: 'product-card-image' }}
          </div>
          <div class="product-card-info" style="text-align: center;">
            <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--color-text, #0f172a);">Example Collection</h3>
            <span style="font-size: 0.85rem; opacity: 0.7;">0 products</span>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Collections List",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "All Collections"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Number of columns on desktop",
      "options": [
        { "value": "3", "label": "3 columns" },
        { "value": "4", "label": "4 columns" }
      ],
      "default": "4"
    }
  ]
}
{% endschema %}
