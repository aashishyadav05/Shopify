<div class="container" style="padding-top: 3rem; padding-bottom: 5rem;">
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 4rem; align-items: start;">
    
    <!-- Media Gallery Column -->
    <div>
      <div style="aspect-ratio: 1/1; background: var(--color-card-bg, #f8fafc); border-radius: var(--border-radius, 12px); overflow: hidden; border: 1px solid var(--color-border, #e2e8f0);">
        {% if product.featured_media != blank %}
          <img
            src="{{ product.featured_media | image_url: width: 1000 }}"
            alt="{{ product.featured_media.alt | escape }}"
            data-main-product-image
            width="1000"
            height="1000"
            style="width: 100%; height: 100%; object-fit: cover;"
          >
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {% endif %}
      </div>

      {% if product.media.size > 1 %}
        <div style="display: flex; gap: 0.75rem; margin-top: 1rem; overflow-x: auto;">
          {% for media in product.media %}
            <button
              type="button"
              onclick="document.querySelector('[data-main-product-image]').src='{{ media | image_url: width: 1000 }}'"
              style="border: 1px solid var(--color-border, #e2e8f0); border-radius: 8px; overflow: hidden; width: 70px; height: 70px; padding: 0; background: none; cursor: pointer;"
            >
              <img
                src="{{ media | image_url: width: 140 }}"
                alt="{{ media.alt | escape }}"
                width="140"
                height="140"
                style="width:100%; height:100%; object-fit:cover;"
              >
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Details Column -->
    <div>
      {% for block in section.blocks %}
        {% case block.type %}
          {% when '@app' %}
            {% render block %}

          {% when 'title' %}
            <h1 style="font-size: 2.25rem; font-weight: 800; margin-bottom: 0.5rem;" {{ block.shopify_attributes }}>
              {{ product.title | default: 'onboarding.product_title' | t }}
            </h1>

          {% when 'price' %}
            <div style="font-size: 1.5rem; font-weight: 700; margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.75rem;" {{ block.shopify_attributes }}>
              <span data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>
              {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
                <span data-product-compare-price class="price-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
              {% endif %}
            </div>

          {% when 'variant_picker' %}
            {% unless product.has_only_default_variant %}
              <div style="margin-bottom: 1.5rem;" {{ block.shopify_attributes }}>
                <label style="display: block; font-weight: 600; margin-bottom: 0.5rem;">{{ 'products.product.select_options' | t }}</label>
                <select
                  name="id"
                  data-variant-select
                  style="width: 100%; padding: 0.75rem; border-radius: var(--border-radius, 12px); border: 1px solid var(--color-border, #e2e8f0); background: var(--color-bg, #ffffff);"
                >
                  {% for variant in product.variants %}
                    <option
                      value="{{ variant.id }}"
                      data-price="{{ variant.price | money }}"
                      data-compare-price="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                      data-image="{% if variant.image %}{{ variant.image | image_url: width: 1000 }}{% endif %}"
                      {% if variant == product.selected_or_first_available_variant %}selected{% endif %}
                      {% unless variant.available %}disabled{% endunless %}
                    >
                      {{ variant.title }} - {{ variant.price | money }} {% unless variant.available %}({{ 'products.product.sold_out' | t }}){% endunless %}
                    </option>
                  {% endfor %}
                </select>
              </div>
            {% endunless %}

          {% when 'buy_buttons' %}
              {% form 'product', product, data-add-to-cart-form: '' %}
                <input type="hidden" name="id" data-product-variant-id value="{{ product.selected_or_first_available_variant.id }}">

                <div style="display: flex; gap: 1rem; margin-bottom: 1.5rem;">
                  <div style="width: 100px;">
                    <input
                      type="number"
                      name="quantity"
                      value="1"
                      min="1"
                      aria-label="{{ 'products.product.quantity' | t }}"
                      style="width: 100%; padding: 0.75rem; border-radius: var(--border-radius, 12px); border: 1px solid var(--color-border, #e2e8f0); text-align: center;"
                    >
                  </div>

                  <button
                    type="submit"
                    name="add"
                    class="btn btn-primary"
                    style="flex-grow: 1;"
                    {% unless product.available %}disabled{% endunless %}
                  >
                    {% if product.available %}
                      {{ 'products.product.add_to_cart' | t }}
                    {% else %}
                      {{ 'products.product.sold_out' | t }}
                    {% endif %}
                  </button>
                </div>

                {% if block.settings.show_dynamic_checkout %}
                  {{ form | payment_button }}
                {% endif %}
              {% endform %}
            </div>

          {% when 'description' %}
            {% if product.description != blank %}
              <div style="margin-top: 2rem; border-top: 1px solid var(--color-border, #e2e8f0); padding-top: 1.5rem; line-height: 1.7;" {{ block.shopify_attributes }}>
                {{ product.description }}
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
    </div>

  </div>
</div>

{% schema %}
{
  "name": "Product Details",
  "tag": "section",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "Variant Picker",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "Buy Buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1
    }
  ],
  "default": {
    "blocks": [
      { "type": "title" },
      { "type": "price" },
      { "type": "variant_picker" },
      { "type": "buy_buttons" },
      { "type": "description" }
    ]
  }
}
{% endschema %}
