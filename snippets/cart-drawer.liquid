<div class="cart-drawer-overlay" data-cart-drawer-overlay></div>

<div class="cart-drawer" data-cart-drawer>
  <div class="cart-drawer-header">
    <h2 style="font-size: 1.25rem; font-weight: 700;">Your Shopping Cart</h2>
    <button type="button" class="icon-btn" data-close-cart-drawer aria-label="Close cart">
      {% render 'icon-close' %}
    </button>
  </div>

  <div
    class="cart-drawer-body"
    data-cart-drawer-body
    data-shipping-threshold="{{ settings.free_shipping_threshold | default: 100 }}"
  >
    {% if cart.item_count == 0 %}
      <div style="text-align: center; padding: 3rem 0; opacity: 0.7;">
        <p>Your cart is empty.</p>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="cart-item" data-key="{{ item.key }}">
          <img
            src="{{ item.image | image_url: width: 200 }}"
            alt="{{ item.title | escape }}"
            class="cart-item-img"
            width="200"
            height="200"
          >
          <div class="cart-item-details">
            <div class="cart-item-title">{{ item.product.title }}</div>
            {% unless item.product.has_only_default_variant %}
              <div class="cart-item-variant">{{ item.variant.title }}</div>
            {% endunless %}
            <div style="font-weight:700; margin-top:0.25rem;">{{ item.final_line_price | money }}</div>
            <div class="cart-item-qty">
              <button class="qty-btn" onclick="updateCartItemQty('{{ item.key }}', {{ item.quantity | minus: 1 }})">-</button>
              <span class="qty-val">{{ item.quantity }}</span>
              <button class="qty-btn" onclick="updateCartItemQty('{{ item.key }}', {{ item.quantity | plus: 1 }})">+</button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-summary-row">
      <span>Subtotal</span>
      <span data-cart-drawer-total>{{ cart.total_price | money }}</span>
    </div>
    <form action="{{ routes.cart_url }}" method="post">
      <button type="submit" name="checkout" class="btn btn-primary" style="width: 100%;">
        Proceed to Checkout
      </button>
    </form>
  </div>
</div>
